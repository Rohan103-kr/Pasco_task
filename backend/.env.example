# Pasco Foods Backend Configuration

# Server running port
PORT=5000

# MongoDB Connection URI (e.g. local instance or MongoDB Atlas)
# If left blank, server defaults to local 'mongodb://127.0.0.1:27017/pasco-foods' with graceful local JSON fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pasco-foods?retryWrites=true&w=majority

# LLM Chatbot Configuration
# Choose LLM provider: 'ollama' or 'gemini'
LLM_PROVIDER=ollama

# Ollama local settings (used if LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Gemini settings (used if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

